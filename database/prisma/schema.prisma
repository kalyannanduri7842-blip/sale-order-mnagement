// ENTERPRISEPRO ERP — Relational Multi-Tenant Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  PROCUREMENT_MANAGER
  INVENTORY_MANAGER
  FINANCE_MANAGER
  HR_MANAGER
  EMPLOYEE
  VIEWER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
}

model Company {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  industry        String?
  currency        String           @default("USD")
  fiscalYearStart String           @default("01-01")
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String           @default("USA")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           User[]
  departments     Department[]
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  warehouses      Warehouse[]
  salesOrders     SalesOrder[]
  quotations      Quotation[]
  leads           Lead[]
  purchaseOrders  PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  accounts        Account[]
  employees       Employee[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@map("companies")
}

model User {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username      String       @unique
  email         String       @unique
  passwordHash  String
  fullName      String
  role          RoleType     @default(EMPLOYEE)
  phone         String?
  active        Boolean      @default(true)
  lastLogin     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employeeProfile Employee?
  auditLogs       AuditLog[]

  @@map("users")
}

model Department {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  code             String
  description      String?
  headOfDepartment String?
  budget           Float        @default(0.0)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  employees        Employee[]
  purchaseRequests PurchaseRequest[]

  @@map("departments")
}

model Customer {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerCode  String
  name          String
  companyName   String?
  email         String
  phone         String?
  address       String?
  city          String?
  country       String       @default("USA")
  customerType  String       @default("ENTERPRISE") // ENTERPRISE, SMB, GOV
  creditStatus  String       @default("EXCELLENT")
  creditLimit   Float        @default(100000.0)
  totalSpend    Float        @default(0.0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  salesOrders   SalesOrder[]
  quotations    Quotation[]
  invoices      Invoice[]
  leads         Lead[]

  @@map("customers")
}

model Lead {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  title         String
  companyName   String
  contactName   String
  email         String
  phone         String?
  expectedValue Float        @default(0.0)
  stage         String       @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  priority      String       @default("MEDIUM")
  assignedTo    String?
  nextFollowUp  DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("leads")
}

model Quotation {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotationNumber String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  issueDate       DateTime        @default(now())
  expiryDate      DateTime
  subtotal        Float           @default(0.0)
  taxRate         Float           @default(10.0)
  taxAmount       Float           @default(0.0)
  totalAmount     Float           @default(0.0)
  status          String          @default("SENT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  salesperson     String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]
  salesOrders     SalesOrder[]

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  description String?
  quantity    Int       @default(1)
  unitPrice   Float     @default(0.0)
  totalPrice  Float     @default(0.0)

  @@map("quotation_items")
}

model SalesOrder {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber    String           @unique
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  quotationId    String?
  quotation      Quotation?       @relation(fields: [quotationId], references: [id])
  orderDate      DateTime         @default(now())
  deliveryDate   DateTime?
  status         OrderStatus      @default(PENDING)
  paymentStatus  String           @default("UNPAID") // UNPAID, PARTIAL, PAID
  subtotal       Float            @default(0.0)
  taxAmount      Float            @default(0.0)
  shippingCost   Float            @default(0.0)
  totalAmount    Float            @default(0.0)
  shippingMethod String?
  shippingAddress String?
  salesperson    String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          SalesOrderItem[]
  invoices       Invoice[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int        @default(1)
  unitPrice    Float      @default(0.0)
  totalPrice   Float      @default(0.0)

  @@map("sales_order_items")
}

model Supplier {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierCode    String
  name            String
  companyName     String?
  email           String
  phone           String?
  category        String          @default("HARDWARE")
  address         String?
  city            String?
  country         String          @default("USA")
  outstandingPay  Float           @default(0.0)
  rating          Float           @default(5.0)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseRequest {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestCode   String          @unique
  departmentId  String
  department    Department      @relation(fields: [departmentId], references: [id])
  requesterName String
  requiredDate  DateTime
  priority      String          @default("MEDIUM")
  reason        String
  estimatedCost Float           @default(0.0)
  status        String          @default("PENDING_APPROVAL")
  approvedBy    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("purchase_requests")
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber    String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  status         PurchaseStatus      @default(SENT)
  subtotal       Float               @default(0.0)
  taxAmount      Float               @default(0.0)
  shippingCost   Float               @default(0.0)
  totalAmount    Float               @default(0.0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int           @default(1)
  unitCost        Float         @default(0.0)
  totalCost       Float         @default(0.0)

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiptNumber   String        @unique
  receivedDate    DateTime      @default(now())
  receivedBy      String
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  notes           String?

  @@map("goods_receipts")
}

model Product {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  category        String              @default("ENTERPRISE_SOFTWARE")
  unitCost        Float               @default(0.0)
  sellingPrice    Float               @default(0.0)
  stockQuantity   Int                 @default(0)
  reservedStock   Int                 @default(0)
  reorderLevel    Int                 @default(10)
  warehouseId     String?
  warehouse       Warehouse?          @relation(fields: [warehouseId], references: [id])
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  poItems         PurchaseOrderItem[]
  movements       StockMovement[]

  @@map("products")
}

model Warehouse {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  location      String
  managerName   String
  capacity      Int             @default(10000)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  products      Product[]
  goodsReceipts GoodsReceipt[]
  movements     StockMovement[]

  @@map("warehouses")
}

model StockMovement {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  warehouseId  String
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType StockMovementType
  quantity     Int
  reference    String?
  performedBy  String
  movementDate DateTime          @default(now())

  @@map("stock_movements")
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Float         @default(0.0)
  taxAmount     Float         @default(0.0)
  totalAmount   Float         @default(0.0)
  paidAmount    Float         @default(0.0)
  balance       Float         @default(0.0)
  status        InvoiceStatus @default(SENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      Payment[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentNumber String   @unique
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String   @default("BANK_TRANSFER") // BANK_TRANSFER, CARD, CASH, UPI
  reference     String?
  status        String   @default("SUCCESS")

  @@map("payments")
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseNumber String   @unique
  title         String
  category      String   // IT & Infrastructure, Utilities, Marketing, Travel, Operations
  amount        Float
  expenseDate   DateTime @default(now())
  paymentMethod String   @default("CREDIT_CARD")
  reference     String?
  status        String   @default("APPROVED")
  employeeName  String?

  @@map("expenses")
}

model Account {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountNumber String
  accountName   String
  accountType   String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subType       String?  // CASH, BANK, RECEIVABLE, PAYABLE, COGS, OPERATING
  balance       Float    @default(0.0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("accounts")
}

model Employee {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  employeeId       String         @unique
  firstName        String
  lastName         String
  email            String
  phone            String?
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  designationTitle String
  joiningDate      DateTime       @default(now())
  salary           Float          @default(50000.0)
  employmentStatus String         @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  employmentType   String         @default("FULL_TIME") // FULL_TIME, CONTRACT
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  payrolls         Payroll[]

  @@map("employees")
}

model Attendance {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate DateTime  @default(now())
  checkInTime    DateTime?
  checkOutTime   DateTime?
  totalHours     Float     @default(8.0)
  status         String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY

  @@map("attendances")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   String      @default("ANNUAL") // ANNUAL, CASUAL, SICK, UNPAID
  startDate   DateTime
  endDate     DateTime
  totalDays   Int         @default(1)
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Payroll {
  id                   String    @id @default(cuid())
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month                Int
  year                 Int
  totalWorkingDays     Int       @default(22)
  presentDays          Int       @default(22)
  basicSalary          Float
  allowancesTotal      Float     @default(0.0)
  overtimePay          Float     @default(0.0)
  bonuses              Float     @default(0.0)
  grossSalary          Float
  deductionsTotal      Float     @default(0.0)
  taxDeduction         Float     @default(0.0)
  netSalary            Float
  paymentStatus        String    @default("PAID") // PENDING, PAID
  paymentDate          DateTime?
  paymentMethod        String    @default("BANK_TRANSFER")
  transactionReference String?

  @@map("payrolls")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  description String
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}
